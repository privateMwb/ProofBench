root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# C++ sources use four spaces, like the libraries they bind.
[*.{cpp,hpp,h,tpp}]
indent_size = 4

# Built output: never reformatted by hand.
[site/wasm/*]
trim_trailing_whitespace = false
insert_final_newline = unset
end_of_line = unset
